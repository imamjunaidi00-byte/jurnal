# ─────────────────────────────────────────────────────────────────────────────
# E-Journal SMK v2.0 — Konfigurasi Environment
# Salin file ini ke .env lalu sesuaikan nilainya
# cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ── Database MariaDB / MySQL ──────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ejournal_smk
DB_USER=ejournal_user
DB_PASS=ganti_password_aman_di_sini

# Connection pool
DB_POOL_MAX=10
DB_POOL_MIN=2
DB_POOL_ACQ=30000
DB_POOL_IDLE=10000

# ── JWT ───────────────────────────────────────────────────────────────────────
# Wajib diganti! Generate dengan: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=ganti_dengan_string_random_panjang_minimal_64_karakter
JWT_EXPIRE=30d

# ── CORS ──────────────────────────────────────────────────────────────────────
# Kosongkan atau * untuk semua origin, atau isi domain spesifik
CORS_ORIGIN=*

# ── Seed (opsional — dipakai saat node src/database/seed.js) ─────────────────
ADMIN_USER=admin
ADMIN_PASS=Admin@1234
ADMIN_NAMA=Administrator
