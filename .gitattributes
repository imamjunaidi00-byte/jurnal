# Normalise line endings untuk semua text files
* text=auto

# Force LF untuk shell scripts (penting di Linux server)
*.sh text eol=lf
*.bash text eol=lf

# Force LF untuk source code
*.js text eol=lf
*.json text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.html text eol=lf
*.css text eol=lf
*.env.example text eol=lf

# Binary — jangan ubah line endings
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.xlsx binary
*.xls binary
